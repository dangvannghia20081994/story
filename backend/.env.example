APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Gốc CORS cho Next (3000) và Expo web (8090), cách nhau bởi dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Local: localhost — Docker Compose ghi đè thành `db` (service) trong docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=story
DB_USERNAME=story
DB_PASSWORD=story

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=localhost

REDIS_CLIENT=predis
REDIS_PREFIX=""
# Local: localhost — Docker Compose ghi đè thành `redis` (service)
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WORKER_INTERNAL_TOKEN=change-me

TTS_DEFAULT_VOICE_ID=vi-VN-HoaiMyNeural
TTS_NARRATOR_CHARACTER_NAME="Người kể"
API_VERSION=0.1.0

# CMS (sau `php artisan db:seed`): admin@example.com / password — chỉ dùng dev, đổi mật khẩu production
