# Sao chép thành .env: cp .env.example .env — bắt buộc CRAWLER_INTERNAL_TOKEN (trùng backend/.env).
#
# Chạy worker trên máy host: REDIS_HOST=127.0.0.1, CRAWLER_API_BASE_URL=http://localhost:8000 hoặc http://story.test
# Chạy bằng Docker Compose (profile crawler): compose ghi đè REDIS_HOST=redis và CRAWLER_API_BASE_URL=http://backend:8000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
CRAWLER_REDIS_QUEUE=crawler:queue
# Không gồn /api — worker tự nối /api/...
CRAWLER_API_BASE_URL=http://localhost:8000
CRAWLER_INTERNAL_TOKEN=se0h0SIsDFbqh3lyg1kmTqCkknXedKmDfPCEk1ypy4dCz6jl
# CRAWLER_HEADLESS=1
# Playwright: site chậm / CDN — tăng nếu lỗi "Page.goto: Timeout ... exceeded" (ms, 1000–900000)
# CRAWLER_GOTO_TIMEOUT_MS=180000
# CRAWLER_SELECTOR_TIMEOUT_MS=90000
CRAWLER_WORKER_CONCURRENCY=10
CRAWLER_CHAPTER_CONCURRENCY=5