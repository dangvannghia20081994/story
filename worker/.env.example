# Sao chép thành worker/.env và chỉnh giá trị.

REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=story:tts:queue

BACKEND_URL=http://localhost:8000
WORKER_TOKEN=change-me

FFMPEG_PATH=ffmpeg

# --- TTS ---
# ffmpeg = file im 3s (dev); vieneu = VieNeu-TTS (cần cài gói vieneu + wheel llama-cpp — xem README)
TTS_PROVIDER=vieneu

# Tuỳ chọn: 1–4 (khớp CMS) hoặc tên preset đầy đủ — ghi đè voice_id segment đầu trong queue
# VIENEU_PRESET_VOICE_ID=2

# Tuỳ chọn: token HF (Read) — VieNeu tải GGUF/ONNX từ Hub; giảm cảnh báo "unauthenticated" / rate limit
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
