# Sao chép thành .env — dùng cho chạy local và Docker Compose (env_file service worker).
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=story:tts:queue
BACKEND_URL=http://127.0.0.1:8000
WORKER_TOKEN=change-me

# --- TTS ---
# ffmpeg = file im (dev); fpt = FPT.AI Speech v5 (cần FPT_API_KEY)
TTS_PROVIDER=ffmpeg

# FPT.AI — https://docs.fpt.ai/docs/en/speech/api/text-to-speech/
# Header gửi đi: api_key (giá trị = khóa từ console.fpt.ai)
FPT_API_KEY=
FPT_TTS_URL=https://api.fpt.ai/hmi/tts/v5
# voice: banmai | thuminh | myan | linhsan | lannhi | ngoclam | leminh | minhquang | giahuy
FPT_TTS_VOICE=banmai
# speed: +3 … -3 hoặc 0
FPT_TTS_SPEED=0
FPT_TTS_FORMAT=mp3
FPT_POLL_TIMEOUT_SEC=120
FPT_POLL_INTERVAL_SEC=2
# Sau JSON async từ POST TTS, chờ bấy nhiêu giây rồi mới GET file mp3 (mặc định 10).
FPT_ASYNC_FIRST_POLL_DELAY_SEC=10
# Sàn chờ trước GET đầu: thực tế = max(DELAY_SEC, FLOOR_SEC). Đặt 0 để tắt (không khuyến nghị — CDN dễ 404).
FPT_ASYNC_FIRST_POLL_FLOOR_SEC=2
# Nghỉ giữa các chunk (sau khi tải xong MP3 chunk trước, trước POST chunk sau).
FPT_INTER_CHUNK_DELAY_SEC=0.35
