# Copy to .env next to docker-compose.yml (Compose dùng khi substitute ${WORKER_INTERNAL_TOKEN} cho backend + worker):
#   cp compose.env.example .env
WORKER_INTERNAL_TOKEN=dev-worker-token
# Backend đọc backend/.env — đặt REDIS_PREFIX= rỗng ở đó nếu cần đồng bộ queue với worker (xem backend/.env.example).
# Expo web (docker compose service `expo`) mặc định http://localhost:8090 — đã gộp vào CORS_ALLOWED_ORIGINS trong compose.

# Worker (TTS / FPT): khai báo trong worker/.env — xem worker/.env.example (Compose env_file nạp file đó vào container).
