# Copy to .env next to docker-compose.yml nếu cần biến riêng cho Compose (tuỳ chọn):
#   cp compose.env.example .env
# Expo web (docker compose service `expo`) mặc định http://localhost:8090 — đã gộp vào CORS_ALLOWED_ORIGINS trong compose.

# ──────────────────────────────────────────────────────────────────────────
# Token API nội bộ — luôn đặt cùng giá trị trên 2 nơi (backend/.env + worker/.env)
# Sinh trong backend container/host:
#   php artisan crawler:internal-token      → backend/.env + worker-crawler/.env
#   php artisan worker-tts:internal-token   → backend/.env + worker-tts/.env
# ──────────────────────────────────────────────────────────────────────────
# CRAWLER_INTERNAL_TOKEN=
# WORKER_TTS_INTERNAL_TOKEN=
