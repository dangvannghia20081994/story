# Redis (BLPOP) — trùng host với backend khi dùng docker-compose
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# Hoặc một URL: redis://:pass@host:6379/0
# REDIS_URL=

# List key — phải trùng config Laravel `worker_tts.redis_queue_list`
WORKER_TTS_REDIS_QUEUE=story:tts:queue

# API nội bộ (container: http://backend:8000)
BACKEND_API_BASE_URL=http://localhost:8000
WORKER_TTS_INTERNAL_TOKEN=

# Revid TTS API key (tuỳ chọn — override key mặc định trong worker_redis.py)
# REVID_API_KEY=sk_...
# Read timeout khi gọi Revid (giây) — tăng nếu API sinh chậm/timeout. Mặc định 300.
# REVID_READ_TIMEOUT=300
# Giới hạn ký tự mỗi chunk Revid — hạ (vd 4000) nếu hay timeout. Mặc định 9000.
# WORKER_TTS_MAX_CHARS=9000
# Async (luồng mặc định _call_revid_tts_async): tối đa chờ poll (giây, mặc định 600) + nhịp poll (giây, mặc định 5).
# REVID_ASYNC_MAX_WAIT=600
# REVID_ASYNC_POLL=5
