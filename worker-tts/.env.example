# Redis (BLPOP) — trùng host với backend khi dùng docker-compose
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# Hoặc một URL: redis://:pass@host:6379/0
# REDIS_URL=

# List key — phải trùng config Laravel `worker_tts.redis_queue_list`
WORKER_TTS_REDIS_QUEUE=story:tts:queue

# API nội bộ (container: http://backend:8000)
BACKEND_API_BASE_URL=http://localhost:8000
WORKER_TTS_INTERNAL_TOKEN=AoGTpyiaD4tej6bdj53jDEJ7TLdhT6u8dPhiBlisHm5oP0MN

# File giọng mẫu (WAV/MP3), mặc định input.mp3 cạnh script hoặc mount vào /app/input.mp3
REFERENCE_AUDIO_PATH=/app/input.mp3

# Định dạng gửi API nội bộ: wav | mp3 | m4a (cần ffmpeg khi khác wav; image Docker đã có ffmpeg)
# Backend phải cho phép phần mở rộng tương ứng (mặc định config: wav,mp3,m4a)
WORKER_TTS_UPLOAD_FORMAT=mp3
# Bitrate ffmpeg (vd: 192k, 128k)
# WORKER_TTS_FFMPEG_AUDIO_BITRATE=192k
# FFMPEG_PATH=ffmpeg

# Tuỳ chọn — token Hugging Face (đọc public là đủ): bỏ cảnh báo unauthenticated, rate limit cao hơn khi tải model
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
