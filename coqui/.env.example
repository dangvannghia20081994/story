# Copy to coqui/.env — dùng cho Docker compose và run-native.ps1 (đọc biến Process).

# Cổng host → container 5002
COQUI_PORT=5002

# Model Coqui (xem: docker compose run --rm coqui-tts tts-server --list_models)
# Mặc định: nhẹ, 1 giọng EN — đủ để thử API. Multilingual / XTTS nặng hơn (tải lâu).
COQUI_MODEL=tts_models/en/ljspeech/vits
